{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.example.com/schemas/golden-path.schema.json",
  "title": "Golden path contract",
  "description": "golden-path.yaml: what an app needs, never how each cloud provides it. Cross-field rules beyond these live in gold validate.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "platform.example.com/v1"},
    "kind": {"const": "GoldenPath"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "owner"],
      "properties": {
        "name": {"$ref": "#/$defs/slug", "description": "App name"},
        "owner": {"$ref": "#/$defs/slug", "description": "Owning team; maps to a GitLab group and an Argo CD AppProject"}
      }
    },
    "spec": {"$ref": "#/$defs/spec"}
  },
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,38}[a-z0-9]$"},
    "size": {"enum": ["S", "M", "L", "XL"]},
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["archetype", "cloud", "tier", "size", "cost_profile", "arch", "data_class", "network", "environments", "lifecycle"],
      "properties": {
        "archetype": {"enum": ["single-api", "microservices", "event-driven", "microservices-events", "three-tier", "vm-workload", "custom"]},
        "cloud": {"enum": ["aws", "azure", "gcp"]},
        "tier": {"enum": ["bronze", "silver", "gold"]},
        "size": {"$ref": "#/$defs/size"},
        "cost_profile": {"enum": ["spot-first", "balanced", "reserved"]},
        "arch": {"enum": ["arm64", "amd64"]},
        "data_class": {"enum": ["public", "internal", "confidential", "regulated"]},
        "network": {"enum": ["public", "private", "internal-only"]},
        "integrations": {"type": "array", "uniqueItems": true, "items": {"enum": ["object-storage", "event-bus", "secrets"]}},
        "environments": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["dev", "stage", "uat", "prod"]}},
        "lifecycle": {"enum": ["persistent", "ephemeral"]},
        "ttl": {"type": "string", "pattern": "^[1-9][0-9]*h$"},
        "destroy_policy": {"enum": ["on-demand", "ttl", "both"]},
        "databases": {"type": "array", "items": {"$ref": "#/$defs/database"}},
        "services": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}},
        "events": {"$ref": "#/$defs/events"},
        "web": {"type": "array", "items": {"$ref": "#/$defs/web"}},
        "custom": {"$ref": "#/$defs/custom"}
      },
      "allOf": [
        {
          "description": "ttl is required on ephemeral contracts; ttl and destroy_policy are rejected on persistent ones",
          "if": {"properties": {"lifecycle": {"const": "ephemeral"}}},
          "then": {"required": ["ttl"]},
          "else": {"not": {"anyOf": [{"required": ["ttl"]}, {"required": ["destroy_policy"]}]}}
        },
        {
          "description": "The combined path needs its services and event settings",
          "if": {"properties": {"archetype": {"const": "microservices-events"}}},
          "then": {"required": ["services", "events"]}
        },
        {
          "description": "spec.custom is required on the custom path and rejected elsewhere",
          "if": {"properties": {"archetype": {"const": "custom"}}},
          "then": {"required": ["custom"]},
          "else": {"not": {"required": ["custom"]}}
        },
        {
          "description": "Spot capacity is never allowed when the app runs in prod",
          "if": {"properties": {"environments": {"contains": {"const": "prod"}}}},
          "then": {"properties": {"cost_profile": {"not": {"const": "spot-first"}}}}
        }
      ]
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "model", "size"],
      "properties": {
        "name": {"$ref": "#/$defs/slug"},
        "model": {"enum": ["relational", "document", "key-value", "wide-column", "cache"]},
        "engine": {"enum": ["postgres", "mysql", "sqlserver", "mongodb", "default"], "default": "default"},
        "size": {"$ref": "#/$defs/size"},
        "storage_gb": {"type": "integer", "minimum": 10, "maximum": 65536}
      }
    },
    "events": {
      "type": "object",
      "additionalProperties": false,
      "required": ["broker", "schemas"],
      "properties": {
        "broker": {"enum": ["stream", "queue"]},
        "schemas": {"type": "string", "description": "AsyncAPI file, validated against the schema registry in CI"}
      }
    },
    "web": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "render"],
      "properties": {
        "name": {"$ref": "#/$defs/slug"},
        "path": {"type": "string"},
        "render": {"enum": ["static", "server"]},
        "domain": {"type": "string", "format": "hostname"},
        "waf": {"enum": ["managed-rules"]}
      }
    },
    "custom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["justification", "exception_ref", "review_by", "budget_usd_month", "components"],
      "properties": {
        "justification": {"type": "string", "minLength": 30},
        "exception_ref": {"type": "string", "format": "uri"},
        "review_by": {"type": "string", "format": "date", "description": "Within 180 days; gold validate fails an expired review"},
        "budget_usd_month": {"type": "number", "exclusiveMinimum": 0},
        "components": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "module"],
            "properties": {
              "name": {"$ref": "#/$defs/slug"},
              "module": {"type": "string", "description": "A catalog module; gold validate rejects anything else"},
              "size": {"$ref": "#/$defs/size"},
              "public": {"type": "boolean", "default": false},
              "inputs": {"type": "object"}
            }
          }
        },
        "connections": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "destination", "port"],
            "properties": {
              "source": {"type": "string"},
              "destination": {"type": "string", "description": "A component name, or internet"},
              "port": {"type": "integer", "minimum": 1, "maximum": 65535}
            }
          }
        }
      }
    }
  }
}
